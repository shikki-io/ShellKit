# SPM / Swift build artefacts — never committed
.build/
.swiftpm/

# kagami scratch (history shards, caches) — never committed
.kagami/

# moto code-intelligence cache — local tooling artefact, not source
.moto
.moto-cache/
# Secrets — env files and every backup of them never belong in git.
# A backup is git history, not a copy next to the file.
.env
.env.*
*.env
*.env.bak*
*.env.back*
!.env.example
!.env.template
!.env.sample
!.env.dist
!*.env.example
!*.env.template

# macOS Finder metadata — never tracked (PR #3 review).
.DS_Store
**/.DS_Store
