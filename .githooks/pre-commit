#!/usr/bin/env bash
# pre-commit hook — auto-fix and verify ONLY the Swift files this commit stages.
#
# Install: git config core.hooksPath .githooks
# Requires: swiftformat (brew install swiftformat), swiftlint (brew install swiftlint)
# Fleet template: https://github.com/shikki-io/swift-lint-fleet-template
#
# History (2026-09-16): the previous version ran `swiftformat .` and
# `swiftlint --fix` over the ENTIRE repository, then verified with a bare
# `swiftlint --quiet` and blocked whenever that output was non-empty. Two
# consequences, both measured on a real fleet repo:
#
#  1. IT COULD NEVER PASS. `swiftlint --quiet` prints warnings, not just errors,
#     and any mature branch carries hundreds (for_where, cyclomatic_complexity,
#     todo, inclusive_language, ...). `[ -n "$LINT_OUT" ]` was therefore always
#     true, so the hook rejected 100% of commits — including commits touching no
#     Swift at all — and advertised its own `--no-verify` bypass in the failure
#     message. A gate that must always be bypassed is not a gate; it trains
#     everyone to reach for `--no-verify`, which also skips signing.
#
#  2. IT REWROTE THE WHOLE TREE. One ordinary 4-file commit attempt modified 249
#     files (+11976/-11777 — and still 90 files when ignoring ALL whitespace, so
#     `--fix` was editing code, not just formatting). It re-staged only files that
#     were already staged, leaving ~245 reformatted files loose in the worktree,
#     armed for the next `git add -A` to sweep into an unrelated commit. That is
#     how a PR ends up reporting +1492/-1452 for an 8-line change.
#
# This hook now mirrors pre-push: same scope source, same severity, so the two
# gates cannot reach opposite verdicts about one tree.
#
# NOTE: the scope block below is duplicated verbatim in pre-push. That is
# deliberate — install.sh symlinks these hooks as INDIVIDUAL FILES, so a shared
# .githooks/lib/ helper would not exist in consumer repos and every hook would
# die at its `source` line. Keep the two copies byte-identical.

set -euo pipefail

BOLD="\033[1m"
RED="\033[31m"
YELLOW="\033[33m"
GREEN="\033[32m"
CYAN="\033[36m"
RESET="\033[0m"

check_tool() {
    if ! command -v "$1" &>/dev/null; then
        echo -e "${RED}${BOLD}ERROR:${RESET} '$1' not found. Install with: brew install $1"
        echo "       Or skip this hook once with: git commit --no-verify"
        exit 1
    fi
}

check_tool swiftformat
check_tool swiftlint

# ── Scope: what the linter config actually governs ───────────────────────────
# `.swiftlint.yml` declares `included:` and the baseline is generated over
# exactly those paths — but swiftlint IGNORES `included:` when handed explicit
# file paths. Without this filter the hook lints files the config never covers
# and the baseline can never contain. (shi-moto, 2026-09-01: pre-commit reported
# clean while pre-push blocked on a build script outside `included:`.)
CONFIG="${SWIFTLINT_CONFIG:-.swiftlint.yml}"
INCLUDED=()
if [ -f "$CONFIG" ]; then
    # Parse the `included:` block: a list of `  - path` entries terminated by
    # the next top-level key. No YAML dependency — the block is a flat list.
    while IFS= read -r inc; do
        [ -n "$inc" ] && INCLUDED+=("$inc")
    done < <(awk '
        /^included:/       { in_block = 1; next }
        /^[^[:space:]#-]/  { in_block = 0 }
        in_block && /^[[:space:]]*-[[:space:]]*/ {
            sub(/^[[:space:]]*-[[:space:]]*/, "")
            gsub(/^["\047]|["\047]$/, "")
            if ($0 != "") print $0
        }
    ' "$CONFIG")
fi

in_scope() {
    # No `included:` declared → the config governs the whole repo, so every
    # candidate file is in scope. Fail OPEN toward more linting, never less.
    [ "${#INCLUDED[@]}" -eq 0 ] && return 0
    local f="$1" p
    for p in "${INCLUDED[@]}"; do
        case "$f" in "$p"/*|"$p") return 0 ;; esac
    done
    return 1
}

# ── The Swift files THIS commit stages ───────────────────────────────────────
# ACMR: added/copied/modified/renamed — never D, a deleted file has nothing to
# lint and its path is gone. -z keeps paths containing spaces intact.
STAGED=()
while IFS= read -r -d '' f; do
    [ -f "$f" ] && STAGED+=("$f")
done < <(git diff --cached --name-only --diff-filter=ACMR -z -- '*.swift')

if [ "${#STAGED[@]}" -eq 0 ]; then
    echo -e "${GREEN}[pre-commit]${RESET} No staged Swift files — nothing to check."
    exit 0
fi

FILES=()
SKIPPED=0
for f in "${STAGED[@]}"; do
    if in_scope "$f"; then FILES+=("$f"); else SKIPPED=$((SKIPPED + 1)); fi
done

# A file silently dropped from a gate is how a gate stops meaning anything.
if [ "$SKIPPED" -gt 0 ]; then
    echo -e "${YELLOW}[pre-commit]${RESET} ${SKIPPED} staged Swift file(s) are outside ${CONFIG} \`included:\` (${INCLUDED[*]}) — not linted."
    echo -e "  They are NOT exempt: add their directory to \`included:\`, regenerate the baseline, and fix what it reports."
fi

if [ "${#FILES[@]}" -eq 0 ]; then
    echo -e "${GREEN}[pre-commit]${RESET} No staged Swift files in lint scope — nothing to check."
    exit 0
fi

# ── Partial staging: verify, but never auto-fix ──────────────────────────────
# A file with BOTH staged and unstaged changes is a trap for an auto-fixer: the
# formatter rewrites the WORKTREE copy, and re-staging it would sweep in the
# unstaged hunks — silently committing work the author deliberately held back.
FIXABLE=()
PARTIAL=()
for f in "${FILES[@]}"; do
    if [ -n "$(git diff --name-only -- "$f")" ]; then
        PARTIAL+=("$f")
    else
        FIXABLE+=("$f")
    fi
done

if [ "${#PARTIAL[@]}" -gt 0 ]; then
    echo -e "${YELLOW}[pre-commit]${RESET} ${#PARTIAL[@]} file(s) only partially staged — verifying WITHOUT auto-fix,"
    echo -e "  so unstaged changes are never swept into this commit:"
    printf '    %s\n' "${PARTIAL[@]}"
fi

# ── Auto-fix the fully-staged files, then re-stage exactly those ─────────────
if [ "${#FIXABLE[@]}" -gt 0 ]; then
    echo -e "${YELLOW}[pre-commit]${RESET} Auto-fixing ${#FIXABLE[@]} staged Swift file(s)..."
    if ! swiftformat "${FIXABLE[@]}" --quiet; then
        echo -e "${RED}${BOLD}[pre-commit] swiftformat failed.${RESET}"
        echo "  Fix the errors above, then re-stage and re-commit."
        exit 1
    fi
    # `--fix` exits non-zero on unfixable violations; the verify step below is
    # what decides, so its status is advisory here.
    swiftlint --fix --quiet --config "$CONFIG" "${FIXABLE[@]}" >/dev/null 2>&1 || true
    # Explicit pathspecs only — never `git add -A`, which is what lets stray
    # worktree churn ride into commits.
    git add -- "${FIXABLE[@]}"
fi

# ── Verify — same commands and severity as pre-push ──────────────────────────
echo -e "${YELLOW}[pre-commit]${RESET} Verifying ${#FILES[@]} staged Swift file(s)..."
FAILED=0

FORMAT_OUT=$(swiftformat "${FILES[@]}" --lint --quiet 2>&1 || true)
if [ -n "$FORMAT_OUT" ]; then
    echo -e "${RED}${BOLD}[pre-commit] SwiftFormat violations:${RESET}"
    echo "$FORMAT_OUT"
    FAILED=1
fi

LINT_OUT=$(swiftlint lint --strict --quiet --config "$CONFIG" "${FILES[@]}" 2>&1 || true)
# A TOOL DIAGNOSTIC IS NOT A CODE VIOLATION.
#
# This used to be `if [ -n "$LINT_OUT" ]` — ANY output failed the push. swiftlint
# writes its own diagnostics to the same stream, e.g.
#   warning: Cannot open or read the baseline file at path '.swiftlint-baseline.json'.
# so a repo that adopted the fleet config without creating a baseline could not
# push AT ALL, and the "violation" printed was a message about a missing file.
# Measured 2026-10-03 in ShellKit immediately after it adopted the config.
#
# A real violation under `reporter: "xcode"` is `path:line:col: error|warning:`.
# A tool diagnostic has no file:line:col. Both are still PRINTED — the operator
# should see the warning — but only the former blocks.
LINT_VIOLATIONS=$(printf '%s\n' "$LINT_OUT" | grep -E '^.+:[0-9]+:[0-9]+: (error|warning):' || true)
if [ -n "$LINT_OUT" ]; then
    if [ -n "$LINT_VIOLATIONS" ]; then
        echo -e "${RED}${BOLD}[pre-commit] SwiftLint violations:${RESET}"
        echo "$LINT_VIOLATIONS"
        FAILED=1
    else
        echo -e "${YELLOW}[pre-commit] swiftlint diagnostics (not blocking):${RESET}"
        echo "$LINT_OUT"
    fi
fi

# ── Notice — referenced pending markers ──────────────────────────────────────
# Three levels, not two. `error` blocks (swiftlint --strict: a warning IS an
# error here, that is how this fleet refuses debt). `notice` is the third:
# a `FIXME(spec …)` / `TODO(backlog …)` / `FIXME(memory …)` / `TODO(#n)` is
# tracked work with an address — allowed by `unreferenced_todo`, and printed
# HERE, every time, because the people and agents doing the work read this
# terminal, not an IDE's FIXME navigator. Visible, never blocking. Unreferenced
# markers are errors and were already reported above.
#
# Comment context only (`//`, `/*`, `*` before the marker), the same kinds the
# lint rule governs, so the tally and the rule count the same things. The
# reference is taken from the MARKER, never from the rest of the line — a path
# containing `specs/` or a `#12` in prose must not become a phantom reference.
# Content is printed with printf '%s': a marker is repo-controlled text and
# `echo -e` would honour escape sequences inside it.
NOTICE_MARKER='(TODO|FIXME)[[:space:]]*\(((spec|backlog|memory) [^)]+|#[0-9]+)\)'
# The prefix must START the line (after indentation), as the lint rule and
# `kagami lint`'s pending_markers gate require: a `// TODO(...)` inside a
# string literal further along the line is a fixture, not debt.
NOTICE_RE="^[[:space:]]*(//+|/\*+|\*|#|--|<!--)[[:space:]]*([-—•][[:space:]]*)?${NOTICE_MARKER}"
NOTICES=$(grep -nHE "$NOTICE_RE" -- "${FILES[@]}" 2>/dev/null || true)
if [ -n "$NOTICES" ]; then
    NOTICE_COUNT=$(printf '%s\n' "$NOTICES" | wc -l | tr -d ' ')
    printf '%b[pre-commit] notice:%b %s referenced pending marker(s) in the files this pre-commit touches — tracked, not blocking:\n' "${CYAN}${BOLD}" "${RESET}" "$NOTICE_COUNT"
    printf '%s\n' "$NOTICES" | sed -E 's#^([^:]+:[0-9]+):.*((TODO|FIXME)[[:space:]]*\()#  \1  \2#' | cut -c1-170
    NOTICE_REFS=$(printf '%s\n' "$NOTICES" | grep -oE "$NOTICE_MARKER" | sed -E 's/^(TODO|FIXME)[[:space:]]*\(//; s/\)$//' | sort | uniq -c | sort -rn \
        | awk '{ c = $1; $1 = ""; sub(/^ /, ""); printf "%s (x%d)  ", $0, c }')
    printf '  addressed by: %s\n' "$NOTICE_REFS"
fi
if [ "${#INCLUDED[@]}" -gt 0 ]; then
    # `grep` exits 1 when it matches NOTHING, and under `set -euo pipefail`
    # that non-zero status propagates out of the pipeline and `set -e` kills
    # the hook — so a repo with zero pending markers (the healthy case) could
    # not commit or push at all, with no message. Measured 2026-10-03 in
    # ShikkiMCP: "silently killed the hook, blocking all pushes".
    # `|| true` keeps the tally a tally.
    NOTICE_TOTAL=$({ grep -rnE "$NOTICE_RE" --include='*.swift' -- "${INCLUDED[@]}" 2>/dev/null || true; } | wc -l | tr -d ' ')
    if [ "$NOTICE_TOTAL" -gt 0 ]; then
        printf '%b[pre-commit] notice:%b repository total: %s referenced pending marker(s) under %s\n' "${CYAN}${BOLD}" "${RESET}" "$NOTICE_TOTAL" "${INCLUDED[*]}"
    fi
fi

if [ "$FAILED" -eq 1 ]; then
    echo ""
    echo -e "${RED}${BOLD}[pre-commit] Commit blocked — fix the violations above (only files THIS commit stages are checked).${RESET}"
    echo -e "  Fix: swiftformat <files> && swiftlint --fix --config ${CONFIG} <files>"
    echo -e "  Pre-existing debt in files you did not touch will NOT block you here."
    exit 1
fi

echo -e "${GREEN}[pre-commit]${RESET} Staged Swift files clean."
